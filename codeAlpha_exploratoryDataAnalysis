        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import seaborn as sns\n",
        "\n",
        "# 1. Load the dataset created in Task 1\n",
        "df = pd.read_csv(\"scraped_books_data.csv\")\n",
        "\n",
        "# 2. Inspect data structure\n",
        "print(\"--- Dataset Summary ---\")\n",
        "print(df.info())\n",
        "print(\"\\n--- First 5 Rows ---\")\n",
        "print(df.head())\n",
        "\n",
        "# 3. Data Cleaning: Convert 'Price' column from string (e.g. £51.77) to float number\n",
        "df[\"Price_Cleaned\"] = (\n",
        "    df[\"Price\"].str.replace(\"£\", \"\").str.replace(\"Â\", \"\").astype(float)\n",
        ")\n",
        "\n",
        "# 4. Statistical Analysis\n",
        "print(\"\\n--- Price Statistics ---\")\n",
        "print(f\"Average Book Price: £{df['Price_Cleaned'].mean():.2f}\")\n",
        "print(f\"Maximum Book Price: £{df['Price_Cleaned'].max():.2f}\")\n",
        "print(f\"Minimum Book Price: £{df['Price_Cleaned'].min():.2f}\")\n",
        "\n",
        "# 5. Data Visualization (EDA Graphs)\n",
        "plt.figure(figsize=(12, 5))\n",
